[
  {
    "type": "function",
    "name": "get_search_guide",
    "description": "객관 필터·체감 탐색 순서·선택자·집계 지표·데이터 버전·답변 정책을 반환한다.\n    대화 시작 시 한 번 호출해 두면 이후 검색 조건을 정확히 만들 수 있다.",
    "parameters": {
      "properties": {},
      "title": "get_search_guideArguments",
      "type": "object"
    },
    "strict": false
  },
  {
    "type": "function",
    "name": "search_products",
    "description": "객관 조건과 체감 리뷰 조건을 AND로 결합해 검색하고 체감 점수로 정렬한다. 모든 조건을 매번 전달한다.\n\n    결과에는 applied_conditions(타입·조건·적용 내용 JSON), 일치 상품, 문서 미기재로 판정 불가했던 상품,\n    0건일 때의 relaxation_suggestions(제거/완화할 조건 제안)가 들어 있다. null 은 '미지원'이 아니라 '문서 미기재'다.",
    "parameters": {
      "$defs": {
        "AttributeClause": {
          "additionalProperties": false,
          "properties": {
            "aspect_cluster_id": {
              "description": "속성 군집 ID",
              "minLength": 1,
              "title": "Aspect Cluster Id",
              "type": "string"
            },
            "raw_aspect_ids": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "원래 속성 ID 목록. 생략하면 군집 전체",
              "title": "Raw Aspect Ids"
            }
          },
          "required": [
            "aspect_cluster_id"
          ],
          "title": "AttributeClause",
          "type": "object"
        },
        "AttributeSelector": {
          "additionalProperties": false,
          "properties": {
            "clauses": {
              "description": "OR로 결합할 속성 선택 절",
              "items": {
                "$ref": "#/$defs/AttributeClause"
              },
              "minItems": 1,
              "title": "Clauses",
              "type": "array"
            }
          },
          "required": [
            "clauses"
          ],
          "title": "AttributeSelector",
          "type": "object"
        },
        "EvidenceTopic": {
          "additionalProperties": false,
          "properties": {
            "topic_id": {
              "minLength": 1,
