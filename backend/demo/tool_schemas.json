              "type": "string"
            },
            "attribute": {
              "$ref": "#/$defs/AttributeSelector"
            },
            "desired_state_ids": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Desired State Ids"
            },
            "contrary_state_ids": {
              "items": {
                "type": "string"
              },
              "title": "Contrary State Ids",
              "type": "array"
            }
          },
          "required": [
            "topic_id",
            "attribute"
          ],
          "title": "EvidenceTopic",
          "type": "object"
        },
        "ExperienceCondition": {
          "additionalProperties": false,
          "properties": {
            "condition_id": {
              "description": "호출 안에서 유일한 조건 ID",
              "minLength": 1,
              "title": "Condition Id",
              "type": "string"
            },
            "attribute": {
              "$ref": "#/$defs/AttributeSelector"
            },
            "desired_state_ids": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "원하는 원래 상태 ID. 생략하면 상태 제한 없음",
